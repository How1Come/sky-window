{
  "schemaVersion": 1,
  "id": "sky_window",
  "version": "${version}",
  "name": "Sky Window",
  "description": "Seamless ceiling windows onto the live sky, with real skylight underground.",
  "authors": [
    "How1Come"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "dev.skylight.SkylightMod"
    ],
    "client": [
      "dev.skylight.client.SkylightClient"
    ]
  },
  "mixins": [
    "sky_window.mixins.json",
    {
      "config": "sky_window.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.14",
    "minecraft": "1.21",
    "java": ">=21",
    "fabric-api": ">=0.102.0+1.21"
  }
}
